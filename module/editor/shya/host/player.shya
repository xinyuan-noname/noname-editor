// ═══════════════════════════════════════════════════════════════════════════
// player —— 无名杀 `Player`（角色）宿主声明
//
// 只声明**真实存在**且**形状单一**的成员（证据：noname/library/element/player.js）。
// 刻意不声明的（写错比不写更危险，见《风险清单》）：
//   hand / equip / judge   —— Player 上没有这三个牌区数组（手牌在 node.handcards1/2，
//                             判定牌在 node.judges）。取牌用 getCards("h"/"e"/"j")。
//   dead / linked / turnedover / chained / isDead —— 不是属性（classList 实现），
//                             用 isDead() / isLinked() / isTurnedOver()。
//   hasSkills / getJudging / setHp / getMaxHp —— 引擎里不存在，别写。
//   get.name / get.color / get.value … —— 属于 `get` 模块，不是 Card/Player 的方法。
//
// 多形态方法（draw / damage / discard / gain / useCard / respond / judge / chooseXxx）
// 第一个参数一律标 `any`，因为同一个方法既能吃数字也能吃对象（声明成单一定长签名
// 会让合法用法误报 TC006）。可选调用请用**默认值**（`num: any = 1`）表达：
// shya 的 `?:` 不参与实参个数检查（typecheck.cpp:785-799）。
//
// 用法：`import "./host/index.shya"` 后，给自定义函数的参数标注 Player 即可获得
// 类型检查；`player hp` 读属性、`player draw(2)` 调方法，与引擎语义一致。
// ═══════════════════════════════════════════════════════════════════════════
declare Player {
  // ── 字段（player.js:95-108、3411-3415、4002-4010）──
  name: string
  name1: string
  name2: string
  sex: string
  group: string
  identity: string
  isZhu: boolean
  playerid: string
  hp: number
  maxHp: number
  hujia: number
  phaseNumber: number
  skills: array<string>
  hiddenSkills: array<string>
  storage: map
  marks: map
  tempSkills: map
  skipList: array<string>
  judging: array<Card>
  next: Player
  previous: Player

  // ── 状态查询 ──
  isAlive(): boolean
  isDead(): boolean
  isIn(): boolean
  isOut(): boolean
  isDamaged(): boolean
  isHealthy(): boolean
  isDying(): boolean
  isTurnedOver(): boolean
  isLinked(): boolean
  isMin(distance: boolean = false): boolean
  isPhaseUsing(notmeisok: boolean = false): boolean
  hasSkill(skill: string): boolean
  hasSex(sex: string): boolean
  isFriendOf(player: Player): boolean
  isEnemyOf(player: Player): boolean
  hasJudge(name: string): boolean
  hasEmptySlot(type: any): boolean
  hasMark(name: string): boolean
  hasStorage(name: string, value: any = void): boolean

  // ── 牌区 / 牌堆历史 ──
  getCards(position: string = "h", filter: any = void): array<Card>
  countCards(position: string = "h", filter: any = void): number
  hasCard(pattern: string, position: string = "h"): boolean
  hasCards(position: string = "h", filter: any = void): boolean
  getEquip(name: any): Card
  getEquips(subtype: string = ""): array<Card>
  getJudge(name: string): Card
  getHistory(key: string = "", filter: any = void, last: boolean = false): array<any>
  countHistory(key: string, filter: any = void, last: boolean = false): number
  hasHistory(key: string, filter: any = void, last: boolean = false): boolean
  countUsed(card: any, type: boolean = false): number

  // ── 数值 / 距离 / 可用性 ──
  getHp(raw: boolean = false): number
  getDamagedHp(raw: boolean = false): number
  getHandcardLimit(): number
  getAttackRange(raw: boolean = false): number
  getCardUsable(card: Card, pure: boolean = false): number
  countMark(name: string): number
  distanceTo(target: Player, method: any = void): number
  distanceFrom(target: Player, method: any = void): number
  inRange(target: Player): boolean
  inRangeOf(source: Player): boolean
  canUse(card: any, target: Player = void, distance: number = void, includecard: boolean = false): boolean
  canRespond(event: any = void, card: any = void, type: any = void): boolean

  // ── 动作（返回可 await 的事件）──
  // ⚠️ 这些方法的实参是**变长**的：引擎里都是 `const args = [...arguments]` 后按类型分派
  //    （player.js:7613 draw / 8615 damage / 8729 recover / 8268 gain / 7792 discard /
  //     7386 useCard / 7988 respond / 9482 judge）。声明成定长（`params: any = void`）会让
  //    `player.draw(2, "nodelay")`、`player.gain(cards, "gain2")` 这类**合法**写法误报 TC006
  //    ——报的是 error 不是 warning，所以多形态方法一律写 `...args`。
  draw(...args: any[]): void
  recover(...args: any[]): void
  loseHp(num: any = 1): void
  damage(...args: any[]): void
  die(reason: any = void): void
  dying(reason: any = void): void
  changeHp(num: number, popup: boolean = false): void
  discard(...args: any[]): void
  gain(...args: any[]): void
  lose(...args: any[]): void
  equip(card: Card, draw: boolean = false): void
  useCard(...args: any[]): void
  respond(...args: any[]): void
  judge(...args: any[]): void
  turnOver(bool: boolean = true): void
  link(bool: boolean = true): void
  skip(name: string): void

  // ── 交互（参数形态多，一律变长 any；证据：player.js:5634 chooseToUse / 5698 chooseToRespond /
  //    5858 chooseToDiscard / 6343 chooseCard / 6501 chooseTarget / 6716 chooseBool /
  //    6676 chooseControl / 6110 chooseCardButton / 6557 chooseCardTarget /
  //    6934 discardPlayerCard / 7017 gainPlayerCard）──
  chooseToUse(...args: any[]): void
  chooseToRespond(...args: any[]): void
  chooseToDiscard(...args: any[]): void
  chooseCard(...args: any[]): void
  chooseTarget(...args: any[]): void
  chooseBool(...args: any[]): void
  chooseControl(...args: any[]): void
  chooseCardButton(...args: any[]): void
  chooseCardTarget(...args: any[]): void
  chooseToGuanxing(...args: any[]): void
  discardPlayerCard(...args: any[]): void
  gainPlayerCard(...args: any[]): void

  // ── 牌区搬运 / 查询（证据：player.js:8505 give、7947 loseToDiscardpile、
  //    8389 addToExpansion、8253 gainMultiple、10049 getExpansions、5370 countGainableCards）──
  give(...args: any[]): void
  loseToDiscardpile(...args: any[]): void
  addToExpansion(...args: any[]): void
  gainMultiple(...args: any[]): void
  getExpansions(...args: any[]): array<Card>
  countGainableCards(...args: any[]): number

  // ── 体力上限（证据：player.js:8841 loseMaxHp、8866 gainMaxHp）──
  loseMaxHp(...args: any[]): void
  gainMaxHp(...args: any[]): void

  // ── 技能 / 标记 ──
  getSkills(skillMode: any = void, includeEquipSkills: any = void, applySkillFilter: any = void): array<string>
  addSkill(skill: string, checkConflict: boolean = false): void
  addTempSkill(skill: string, expire: string, checkConflict: boolean = false): void
  addSkills(...args: any[]): void
  addAdditionalSkill(skill: string, skillsToAdd: string, keep: boolean = false): void
  removeSkill(skill: string): void
  awakenSkill(skill: string, nounmark: boolean = false): void
  changeZhuanhuanji(skill: string): void
  markSkill(name: string, info: any = void, card: any = void, nobroadcast: boolean = false): void
  unmarkSkill(name: string, nobroadcast: boolean = false): void
  addMark(name: string, num: number = 1, log: boolean = true): void
  removeMark(name: string, num: number = 1, log: boolean = true): void
  setMark(name: string, num: number, log: boolean = true): void
  setStorage(name: string, value: any, mark: boolean = false): any
  getStorage(name: string, defaultValue: any = void): any
  getNext(): Player
  getPrevious(): Player

  // ── 指示线 / 常用查询（证据：player.js:4824 line、13325 hasZhuSkill、13503 hasSha、
  //    13238 needsToDiscard）──
  line(...args: any[]): void
  hasZhuSkill(...args: any[]): boolean
  hasSha(...args: any[]): boolean
  needsToDiscard(...args: any[]): boolean
}
