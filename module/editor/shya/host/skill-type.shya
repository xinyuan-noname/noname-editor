// ═══════════════════════════════════════════════════════════════════════════
// skill-type —— 无名杀技能类型宏库（魂氏编辑器 / shya 宿主库）
//
// 一个技能类别一个宏，宏体按 resources/app/character/standard/skill.js 的真实
// 字段形状写：函数型字段一律**方法简写**（`filter(event, player) { … }`），
// `content` / `cost` 一律 `async`；类别名与旧版编辑器「技能种类」一致
// （module/editor/skill/editor.mjs:922-928 的 skillCategories）。
//
//   旧版编辑器类别        宏                      产物开头字段
//   ─────────────────────────────────────────────────────────────────────
//   触发类                @skill_trigger          trigger:{ … }
//   出牌阶段类            @skill_phaseUse         enable:"phaseUse"
//   使用类                @skill_chooseToUse      enable:"chooseToUse"
//   打出类                @skill_chooseToRespond  enable:"chooseToRespond"
//   使用打出类            @skill_useRespond       enable:["chooseToUse","chooseToRespond"]
//   视为技（正交）        @skill_viewAs           enable + viewAs
//   修改技                @skill_mod              mod:{ … }
//   组合技                @skill_group            group:[ … ]
//   自由技能（兜底）      @skill_raw              #object 原样展开
//
// 通用插槽（所有技能宏都有）：
//   #skill:Ident?      技能 id。省略 → 整条定义不产出（可用于只写片段）
//   #translation:Str?  技能名   → 产物字段 translation（注入时归位到 lib.translate）
//   #description:Str?  技能描述 → 产物字段 description（归位到 <id>_info）
//   #ai:ObjectLit?     整块 ai 字段
//
// 技能标签（每个技能宏都有，共 39 个槽；旧版「技能标签」页 + 「特殊设置」页）：
//   标签**不按技能种类过滤**（旧版九个页面的按钮永远全在），任何标签都能写在任何宏上；
//   槽名就是产物字段名，省略的标签整条消失。数据与映射见 module/editor/shya/tags.mjs。
//     #forced / #frequent / #direct / #forceDie / … : Bool?   → `<槽>: true`
//     #locked / #lose / #discard / #delay: Bool?               → `<槽>: false`（旧版 locked-false 等）
//     #usable / #round: Num?                                    → `usable: n` / `round: n`
//     #groupSkill: Str?                                         → `groupSkill: "wei"`
//     #animationColor: Str?                                     → `animationColor: "fire"`
//     #init: stmt                                               → init 方法（旧版 mainVice-remove1 阴阳鱼减半个）
//   完整槽表见每个宏参数表里的「技能标签」段（顺序与 tags.mjs 的 TAG_SLOTS 一致）。
//
//
// 最小用法（编辑器会自动注入 `import "./host/skill-type.shya"`，手写也可以）：
//
//   @skill_trigger {
//     #skill: my_recover
//     #translation: "回春"
//     #description: "结束阶段开始时，你可以回复 1 点体力。"
//     #trigger: "phaseJieshuBegin"
//     #filter: return player hp < player maxHp
//     #content: player recover(1)
//   }
//
// 约定与坑（改这个文件前先读）：
//  1. 插槽值**直接写语句**，不要包大括号：`#content: { … }` 会被当成对象字面量
//     （parser.cpp:1792 的 looksLikeObjectLit）。多条语句另起一行写，
//     直到下一个 `#插槽:` 或调用结束的 `}` 为止。
//  2. 语句体插槽（#filter/#check/#cost/#content/#filterCard/#filterTarget/#viewAsFilter）
//     在宏体里**裸写**（`#filter`），不要用 `@ts{ #槽 }` 包 —— 那是把用户的 shya 语句
//     当原始 JS 塞进函数体（还会多一层裸块 `{ … } ;`），类型检查/格式化全绕过。
//     裸槽要求编译器把语句插槽**按语句展开**：`src/macro.cpp` 的 instStmts
//     （ExprStmt(SlotRef) 分支）与 instBody()（if 分支、while/for-of 体、for-of @range 的体），
//     2026-10 修复；`@ts{}` 只留给**表达式位置**的值拼接（见下面的 @__skillTriggerValue 等）。
//     ⚠️ 扩展内置 wasm 必须与这份宏库同批：`module/editor/shya/bin/shya.wasm`
//     （构建 `build-wasm.bat`，产物在 `build/wasm/`）——旧 wasm 会把多条语句拼成成员链。
//  3. 过滤器类槽（filter / filterCard / filterTarget / check）的末尾由宏补
//     `return true`，与旧版编辑器一致：写了 `return` 就提前返回，没写就是永远成立。
//  4. 省略某个可选插槽时，那个成员**整条消失**（靠 `<插槽>…</插槽>` 作用域），
//     产物里不会留下 `xxx: undefined` —— 这需要 shya ≥ 1.3.0 的编译器。
//  5. `#trigger: "phaseEnd"` 是糖 → `trigger:{ player: "phaseEnd" }`；
//     多键 / 多事件照官方写对象：`#trigger: { global: "judge", player: ["a","b"] }`。
//  6. 宏没覆盖的字段（audio / intro / onremove / charlotte / subSkill / getIndex /
//     logTarget / derivation / 任意 mod 钩子以外的钩子）走 @skill_raw 整块写。
//
// 四个 enable 类宏（@skill_phaseUse / @skill_chooseToUse / @skill_chooseToRespond /
// @skill_useRespond）的成员表是**刻意平行**的，改其中一个记得同步另外三个。
// ═══════════════════════════════════════════════════════════════════════════

// 宿主声明（Player / Card / GameEvent / Game）：宏体里的方法形参都标了这些类型，
// 所以技能体里的 `player hp` / `player draw(2)` / `card suit` 会被真正类型检查，
// 未声明的成员只是 TC014 警告（按属性读取处理），不会拦下合法代码。
import "./player.shya"
import "./card.shya"
import "./event.shya"
import "./game.shya"
// ── 内部：把「事件名字符串 / 事件数组 / 事件对象」归一成 trigger 字段的值 ──
// 字符串与数组默认落 player 键，与官方 `trigger:{ player: "phaseEnd" }` 同义。
macro @__skillTriggerValue(#t: expr?) {
  @when(#t is Str) @ts{{ player: #t }}
  @when(#t is ArrayLit) @ts{{ player: #t }}
  @when(#t is ObjectLit) @ts{#t}
}

// ── 内部：ai 字段默认值（省略时给一个「对自己有利就发动」的保底 AI） ──
macro @__skillAiValue(#ai: expr?) {
  @when(#ai is ObjectLit) @ts{#ai}
  @when(#ai is void) @ts{{ order: 1, result: { player: 1 } }}
}

// ── 内部：启用方式默认值（视为技省略 #enable 时按「使用打出类」处理） ──
macro @__skillEnableValue(#enable: expr?) {
  @when(#enable is Str) @ts{#enable}
  @when(#enable is ArrayLit) @ts{#enable}
  @when(#enable is void) @ts{["chooseToUse", "chooseToRespond"]}
}

// ════════════════════════════════════ 触发类 ════════════════════════════════
// 旧版编辑器 kind = 'trigger'；可发动性由 filter（自动触发门）与 check（AI/玩家
// 是否发动）决定，锁定技写 #forced: true。
macro @skill_trigger(
  #skill: Ident?,
  #translation: Str?,
  #description: Str?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #forced: Bool?,
  #frequent: Bool?,
  #direct: Bool?,
  #forceDie: Bool?,
  #locked: Bool?,
  #persevereSkill: Bool?,
  #charlotte: Bool?,
  #superCharlotte: Bool?,
  #limited: Bool?,
  #juexingji: Bool?,
  #dutySkill: Bool?,
  #skillAnimation: Bool?,
  #zhuSkill: Bool?,
  #zhuanhuanji: Bool?,
  #hiddenSkill: Bool?,
  #clanSkill: Bool?,
  #sunbenSkill: Bool?,
  #chargeSkill: Bool?,
  #zhenfa: Bool?,
  #mainSkill: Bool?,
  #viceSkill: Bool?,
  #preHidden: expr?,
  #deadTarget: Bool?,
  #includeOut: Bool?,
  #multitarget: Bool?,
  #complexTarget: Bool?,
  #lose: Bool?,
  #discard: Bool?,
  #delay: Bool?,
  #complexCard: Bool?,
  #mark: Bool?,
  #multiline: Bool?,
  #firstDo: Bool?,
  #lastDo: Bool?,
  #usable: Num?,
  #round: Num?,
  #groupSkill: Str?,
  #animationColor: Str?,
  #init: stmt,
  #trigger: expr?,
  #filter: stmt,
  #check: stmt,
  #cost: stmt,
  #content: stmt,
  #ai: ObjectLit?
) {
  #skill = {
    <translation>translation: #translation,</translation>
    <description>description: #description,</description>
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <forced>forced: #forced,</forced>
    <frequent>frequent: #frequent,</frequent>
    <direct>direct: #direct,</direct>
    <forceDie>forceDie: #forceDie,</forceDie>
    <locked>locked: #locked,</locked>
    <persevereSkill>persevereSkill: #persevereSkill,</persevereSkill>
    <charlotte>charlotte: #charlotte,</charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <limited>limited: #limited,</limited>
    <juexingji>juexingji: #juexingji,</juexingji>
    <dutySkill>dutySkill: #dutySkill,</dutySkill>
    <skillAnimation>skillAnimation: #skillAnimation,</skillAnimation>
    <zhuSkill>zhuSkill: #zhuSkill,</zhuSkill>
    <zhuanhuanji>zhuanhuanji: #zhuanhuanji,</zhuanhuanji>
    <hiddenSkill>hiddenSkill: #hiddenSkill,</hiddenSkill>
    <clanSkill>clanSkill: #clanSkill,</clanSkill>
    <sunbenSkill>sunbenSkill: #sunbenSkill,</sunbenSkill>
    <chargeSkill>chargeSkill: #chargeSkill,</chargeSkill>
    <zhenfa>zhenfa: #zhenfa,</zhenfa>
    <mainSkill>mainSkill: #mainSkill,</mainSkill>
    <viceSkill>viceSkill: #viceSkill,</viceSkill>
    <preHidden>preHidden: #preHidden,</preHidden>
    <deadTarget>deadTarget: #deadTarget,</deadTarget>
    <includeOut>includeOut: #includeOut,</includeOut>
    <multitarget>multitarget: #multitarget,</multitarget>
    <complexTarget>complexTarget: #complexTarget,</complexTarget>
    <lose>lose: #lose,</lose>
    <discard>discard: #discard,</discard>
    <delay>delay: #delay,</delay>
    <complexCard>complexCard: #complexCard,</complexCard>
    <mark>mark: #mark,</mark>
    <multiline>multiline: #multiline,</multiline>
    <firstDo>firstDo: #firstDo,</firstDo>
    <lastDo>lastDo: #lastDo,</lastDo>
    <usable>usable: #usable,</usable>
    <round>round: #round,</round>
    <groupSkill>groupSkill: #groupSkill,</groupSkill>
    <animationColor>animationColor: #animationColor,</animationColor>
    <init>
      init(player: Player, skill) {
        #init
      },
    </init>
    <trigger>trigger: @__skillTriggerValue(#trigger),</trigger>
    <filter>
      filter(event: GameEvent, player: Player) {
        #filter
        return true
      },
    </filter>
    <check>
      check(event: GameEvent, player: Player) {
        #check
        return true
      },
    </check>
    <cost>
      async cost(event: GameEvent, trigger: GameEvent, player: Player) {
        #cost
      },
    </cost>
    <content>
      async content(event: GameEvent, trigger: GameEvent, player: Player) {
        #content
      },
    </content>
    <ai>ai: @__skillAiValue(#ai),</ai>
  }
}

// ═══════════════════════════════ 出牌阶段类 ══════════════════════════════════
// 旧版编辑器 kind = 'enable:"phaseUse"'；选牌条件写 #filterCard（体，末尾自动补
// return true），或用 #filterCardValue 直接给值（`true` / `{ name: "sha" }`，
// 写了它就以它为准）；选角色条件写 #filterTarget。主动技请务必给 #ai。
macro @skill_phaseUse(
  #skill: Ident?,
  #translation: Str?,
  #description: Str?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #forced: Bool?,
  #frequent: Bool?,
  #direct: Bool?,
  #forceDie: Bool?,
  #locked: Bool?,
  #persevereSkill: Bool?,
  #charlotte: Bool?,
  #superCharlotte: Bool?,
  #limited: Bool?,
  #juexingji: Bool?,
  #dutySkill: Bool?,
  #skillAnimation: Bool?,
  #zhuSkill: Bool?,
  #zhuanhuanji: Bool?,
  #hiddenSkill: Bool?,
  #clanSkill: Bool?,
  #sunbenSkill: Bool?,
  #chargeSkill: Bool?,
  #zhenfa: Bool?,
  #mainSkill: Bool?,
  #viceSkill: Bool?,
  #preHidden: expr?,
  #deadTarget: Bool?,
  #includeOut: Bool?,
  #multitarget: Bool?,
  #complexTarget: Bool?,
  #lose: Bool?,
  #discard: Bool?,
  #delay: Bool?,
  #complexCard: Bool?,
  #mark: Bool?,
  #multiline: Bool?,
  #firstDo: Bool?,
  #lastDo: Bool?,
  #usable: Num?,
  #round: Num?,
  #groupSkill: Str?,
  #animationColor: Str?,
  #init: stmt,
  #filter: stmt,
  #filterCard: stmt,
  #filterCardValue: expr?,
  #selectCard: expr?,
  #filterTarget: stmt,
  #selectTarget: Num?,
  #position: Str?,
  #prompt: Str?,
  #check: stmt,
  #content: stmt,
  #ai: ObjectLit?
) {
  #skill = {
    enable: "phaseUse",
    <translation>translation: #translation,</translation>
    <description>description: #description,</description>
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <forced>forced: #forced,</forced>
    <frequent>frequent: #frequent,</frequent>
    <direct>direct: #direct,</direct>
    <forceDie>forceDie: #forceDie,</forceDie>
    <locked>locked: #locked,</locked>
    <persevereSkill>persevereSkill: #persevereSkill,</persevereSkill>
    <charlotte>charlotte: #charlotte,</charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <limited>limited: #limited,</limited>
    <juexingji>juexingji: #juexingji,</juexingji>
    <dutySkill>dutySkill: #dutySkill,</dutySkill>
    <skillAnimation>skillAnimation: #skillAnimation,</skillAnimation>
    <zhuSkill>zhuSkill: #zhuSkill,</zhuSkill>
    <zhuanhuanji>zhuanhuanji: #zhuanhuanji,</zhuanhuanji>
    <hiddenSkill>hiddenSkill: #hiddenSkill,</hiddenSkill>
    <clanSkill>clanSkill: #clanSkill,</clanSkill>
    <sunbenSkill>sunbenSkill: #sunbenSkill,</sunbenSkill>
    <chargeSkill>chargeSkill: #chargeSkill,</chargeSkill>
    <zhenfa>zhenfa: #zhenfa,</zhenfa>
    <mainSkill>mainSkill: #mainSkill,</mainSkill>
    <viceSkill>viceSkill: #viceSkill,</viceSkill>
    <preHidden>preHidden: #preHidden,</preHidden>
    <deadTarget>deadTarget: #deadTarget,</deadTarget>
    <includeOut>includeOut: #includeOut,</includeOut>
    <multitarget>multitarget: #multitarget,</multitarget>
    <complexTarget>complexTarget: #complexTarget,</complexTarget>
    <lose>lose: #lose,</lose>
    <discard>discard: #discard,</discard>
    <delay>delay: #delay,</delay>
    <complexCard>complexCard: #complexCard,</complexCard>
    <mark>mark: #mark,</mark>
    <multiline>multiline: #multiline,</multiline>
    <firstDo>firstDo: #firstDo,</firstDo>
    <lastDo>lastDo: #lastDo,</lastDo>
    <usable>usable: #usable,</usable>
    <round>round: #round,</round>
    <groupSkill>groupSkill: #groupSkill,</groupSkill>
    <animationColor>animationColor: #animationColor,</animationColor>
    <init>
      init(player: Player, skill) {
        #init
      },
    </init>
    <filter>
      filter(event: GameEvent, player: Player) {
        #filter
        return true
      },
    </filter>
    <filterCard>
      filterCard(card: Card, player: Player) {
        #filterCard
        return true
      },
    </filterCard>
    <filterCardValue>filterCard: #filterCardValue,</filterCardValue>
    <selectCard>selectCard: #selectCard,</selectCard>
    <filterTarget>
      filterTarget(card: Card, player: Player, target: Player) {
        #filterTarget
        return true
      },
    </filterTarget>
    <selectTarget>selectTarget: #selectTarget,</selectTarget>
    <position>position: #position,</position>
    <prompt>prompt: #prompt,</prompt>
    <check>
      check(card: Card) {
        #check
        return true
      },
    </check>
    <content>
      async content(event: GameEvent, trigger: GameEvent, player: Player) {
        #content
      },
    </content>
    <ai>ai: @__skillAiValue(#ai),</ai>
  }
}

// ═════════════════════════════════ 使用类 ════════════════════════════════════
// 旧版编辑器 kind = 'enable:"chooseToUse"'；出牌阶段之外也能主动使用的技能。
macro @skill_chooseToUse(
  #skill: Ident?,
  #translation: Str?,
  #description: Str?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #forced: Bool?,
  #frequent: Bool?,
  #direct: Bool?,
  #forceDie: Bool?,
  #locked: Bool?,
  #persevereSkill: Bool?,
  #charlotte: Bool?,
  #superCharlotte: Bool?,
  #limited: Bool?,
  #juexingji: Bool?,
  #dutySkill: Bool?,
  #skillAnimation: Bool?,
  #zhuSkill: Bool?,
  #zhuanhuanji: Bool?,
  #hiddenSkill: Bool?,
  #clanSkill: Bool?,
  #sunbenSkill: Bool?,
  #chargeSkill: Bool?,
  #zhenfa: Bool?,
  #mainSkill: Bool?,
  #viceSkill: Bool?,
  #preHidden: expr?,
  #deadTarget: Bool?,
  #includeOut: Bool?,
  #multitarget: Bool?,
  #complexTarget: Bool?,
  #lose: Bool?,
  #discard: Bool?,
  #delay: Bool?,
  #complexCard: Bool?,
  #mark: Bool?,
  #multiline: Bool?,
  #firstDo: Bool?,
  #lastDo: Bool?,
  #usable: Num?,
  #round: Num?,
  #groupSkill: Str?,
  #animationColor: Str?,
  #init: stmt,
  #filter: stmt,
  #filterCard: stmt,
  #filterCardValue: expr?,
  #selectCard: expr?,
  #filterTarget: stmt,
  #selectTarget: Num?,
  #position: Str?,
  #prompt: Str?,
  #check: stmt,
  #content: stmt,
  #ai: ObjectLit?
) {
  #skill = {
    enable: "chooseToUse",
    <translation>translation: #translation,</translation>
    <description>description: #description,</description>
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <forced>forced: #forced,</forced>
    <frequent>frequent: #frequent,</frequent>
    <direct>direct: #direct,</direct>
    <forceDie>forceDie: #forceDie,</forceDie>
    <locked>locked: #locked,</locked>
    <persevereSkill>persevereSkill: #persevereSkill,</persevereSkill>
    <charlotte>charlotte: #charlotte,</charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <limited>limited: #limited,</limited>
    <juexingji>juexingji: #juexingji,</juexingji>
    <dutySkill>dutySkill: #dutySkill,</dutySkill>
    <skillAnimation>skillAnimation: #skillAnimation,</skillAnimation>
    <zhuSkill>zhuSkill: #zhuSkill,</zhuSkill>
    <zhuanhuanji>zhuanhuanji: #zhuanhuanji,</zhuanhuanji>
    <hiddenSkill>hiddenSkill: #hiddenSkill,</hiddenSkill>
    <clanSkill>clanSkill: #clanSkill,</clanSkill>
    <sunbenSkill>sunbenSkill: #sunbenSkill,</sunbenSkill>
    <chargeSkill>chargeSkill: #chargeSkill,</chargeSkill>
    <zhenfa>zhenfa: #zhenfa,</zhenfa>
    <mainSkill>mainSkill: #mainSkill,</mainSkill>
    <viceSkill>viceSkill: #viceSkill,</viceSkill>
    <preHidden>preHidden: #preHidden,</preHidden>
    <deadTarget>deadTarget: #deadTarget,</deadTarget>
    <includeOut>includeOut: #includeOut,</includeOut>
    <multitarget>multitarget: #multitarget,</multitarget>
    <complexTarget>complexTarget: #complexTarget,</complexTarget>
    <lose>lose: #lose,</lose>
    <discard>discard: #discard,</discard>
    <delay>delay: #delay,</delay>
    <complexCard>complexCard: #complexCard,</complexCard>
    <mark>mark: #mark,</mark>
    <multiline>multiline: #multiline,</multiline>
    <firstDo>firstDo: #firstDo,</firstDo>
    <lastDo>lastDo: #lastDo,</lastDo>
    <usable>usable: #usable,</usable>
    <round>round: #round,</round>
    <groupSkill>groupSkill: #groupSkill,</groupSkill>
    <animationColor>animationColor: #animationColor,</animationColor>
    <init>
      init(player: Player, skill) {
        #init
      },
    </init>
    <filter>
      filter(event: GameEvent, player: Player) {
