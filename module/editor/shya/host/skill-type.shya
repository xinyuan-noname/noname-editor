  #locked: Bool?,
  #persevereSkill: Bool?,
  #charlotte: Bool?,
  #superCharlotte: Bool?,
  #limited: Bool?,
  #juexingji: Bool?,
  #dutySkill: Bool?,
  #skillAnimation: Bool?,
  #zhuSkill: Bool?,
  #zhuanhuanji: Bool?,
  #hiddenSkill: Bool?,
  #clanSkill: Bool?,
  #sunbenSkill: Bool?,
  #chargeSkill: Bool?,
  #zhenfa: Bool?,
  #mainSkill: Bool?,
  #viceSkill: Bool?,
  #preHidden: expr?,
  #deadTarget: Bool?,
  #includeOut: Bool?,
  #multitarget: Bool?,
  #complexTarget: Bool?,
  #lose: Bool?,
  #discard: Bool?,
  #delay: Bool?,
  #complexCard: Bool?,
  #mark: Bool?,
  #multiline: Bool?,
  #firstDo: Bool?,
  #lastDo: Bool?,
  #usable: Num?,
  #round: Num?,
  #groupSkill: Str?,
  #animationColor: Str?,
  #init: stmt,
  #group: expr,
) {
  #skill = {
    <translation>translation: #translation,</translation>
    <description>description: #description,</description>
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <forced>forced: #forced,</forced>
    <frequent>frequent: #frequent,</frequent>
    <direct>direct: #direct,</direct>
    <forceDie>forceDie: #forceDie,</forceDie>
    <locked>locked: #locked,</locked>
    <persevereSkill>persevereSkill: #persevereSkill,</persevereSkill>
    <charlotte>charlotte: #charlotte,</charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <limited>limited: #limited,</limited>
    <juexingji>juexingji: #juexingji,</juexingji>
    <dutySkill>dutySkill: #dutySkill,</dutySkill>
    <skillAnimation>skillAnimation: #skillAnimation,</skillAnimation>
    <zhuSkill>zhuSkill: #zhuSkill,</zhuSkill>
    <zhuanhuanji>zhuanhuanji: #zhuanhuanji,</zhuanhuanji>
    <hiddenSkill>hiddenSkill: #hiddenSkill,</hiddenSkill>
    <clanSkill>clanSkill: #clanSkill,</clanSkill>
    <sunbenSkill>sunbenSkill: #sunbenSkill,</sunbenSkill>
    <chargeSkill>chargeSkill: #chargeSkill,</chargeSkill>
    <zhenfa>zhenfa: #zhenfa,</zhenfa>
    <mainSkill>mainSkill: #mainSkill,</mainSkill>
    <viceSkill>viceSkill: #viceSkill,</viceSkill>
    <preHidden>preHidden: #preHidden,</preHidden>
    <deadTarget>deadTarget: #deadTarget,</deadTarget>
    <includeOut>includeOut: #includeOut,</includeOut>
    <multitarget>multitarget: #multitarget,</multitarget>
    <complexTarget>complexTarget: #complexTarget,</complexTarget>
    <lose>lose: #lose,</lose>
    <discard>discard: #discard,</discard>
    <delay>delay: #delay,</delay>
    <complexCard>complexCard: #complexCard,</complexCard>
    <mark>mark: #mark,</mark>
    <multiline>multiline: #multiline,</multiline>
    <firstDo>firstDo: #firstDo,</firstDo>
    <lastDo>lastDo: #lastDo,</lastDo>
    <usable>usable: #usable,</usable>
    <round>round: #round,</round>
    <groupSkill>groupSkill: #groupSkill,</groupSkill>
    <animationColor>animationColor: #animationColor,</animationColor>
    <init>
      init(player: Player, skill) {
        #init
      },
    </init>
    group: #group,
  }
}

// ══════════════════════════ 自由技能（兜底 / 逃生口） ═════════════════════════
// 上面的宏没覆盖到的字段一律走这里：整个技能对象自己写。
//   @skill_raw {
//     #skill: my_skill
//     #object: {
//       audio: "ext:我的包/audio/skill:2",
//       trigger: { player: "phaseEnd" },
//       forced: true,
//       async content(event: GameEvent, trigger: GameEvent, player: Player) { player draw(1) },
//     }
//   }
macro @skill_raw(
  #skill: Ident?,
  #object: ObjectLit?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #forced: Bool?,
  #frequent: Bool?,
  #direct: Bool?,
  #forceDie: Bool?,
  #locked: Bool?,
  #persevereSkill: Bool?,
  #charlotte: Bool?,
  #superCharlotte: Bool?,
  #limited: Bool?,
  #juexingji: Bool?,
  #dutySkill: Bool?,
  #skillAnimation: Bool?,
  #zhuSkill: Bool?,
  #zhuanhuanji: Bool?,
  #hiddenSkill: Bool?,
  #clanSkill: Bool?,
  #sunbenSkill: Bool?,
  #chargeSkill: Bool?,
  #zhenfa: Bool?,
  #mainSkill: Bool?,
  #viceSkill: Bool?,
  #preHidden: expr?,
  #deadTarget: Bool?,
  #includeOut: Bool?,
  #multitarget: Bool?,
  #complexTarget: Bool?,
  #lose: Bool?,
  #discard: Bool?,
  #delay: Bool?,
  #complexCard: Bool?,
  #mark: Bool?,
  #multiline: Bool?,
  #firstDo: Bool?,
  #lastDo: Bool?,
  #usable: Num?,
  #round: Num?,
  #groupSkill: Str?,
  #animationColor: Str?,
  #init: stmt
) {
  <object>
  #skill = #object
  // @skill_raw 的对象来自 #object 槽，标签并不进字面量，只能挂上去（省略时 Object.assign(x, {}) 是无害空操作）
  Object assign(#skill, {
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <forced>forced: #forced,</forced>
    <frequent>frequent: #frequent,</frequent>
    <direct>direct: #direct,</direct>
    <forceDie>forceDie: #forceDie,</forceDie>
    <locked>locked: #locked,</locked>
    <persevereSkill>persevereSkill: #persevereSkill,</persevereSkill>
    <charlotte>charlotte: #charlotte,</charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <limited>limited: #limited,</limited>
    <juexingji>juexingji: #juexingji,</juexingji>
    <dutySkill>dutySkill: #dutySkill,</dutySkill>
    <skillAnimation>skillAnimation: #skillAnimation,</skillAnimation>
    <zhuSkill>zhuSkill: #zhuSkill,</zhuSkill>
    <zhuanhuanji>zhuanhuanji: #zhuanhuanji,</zhuanhuanji>
    <hiddenSkill>hiddenSkill: #hiddenSkill,</hiddenSkill>
    <clanSkill>clanSkill: #clanSkill,</clanSkill>
    <sunbenSkill>sunbenSkill: #sunbenSkill,</sunbenSkill>
    <chargeSkill>chargeSkill: #chargeSkill,</chargeSkill>
    <zhenfa>zhenfa: #zhenfa,</zhenfa>
    <mainSkill>mainSkill: #mainSkill,</mainSkill>
    <viceSkill>viceSkill: #viceSkill,</viceSkill>
    <preHidden>preHidden: #preHidden,</preHidden>
    <deadTarget>deadTarget: #deadTarget,</deadTarget>
    <includeOut>includeOut: #includeOut,</includeOut>
    <multitarget>multitarget: #multitarget,</multitarget>
    <complexTarget>complexTarget: #complexTarget,</complexTarget>
    <lose>lose: #lose,</lose>
    <discard>discard: #discard,</discard>
    <delay>delay: #delay,</delay>
    <complexCard>complexCard: #complexCard,</complexCard>
    <mark>mark: #mark,</mark>
    <multiline>multiline: #multiline,</multiline>
    <firstDo>firstDo: #firstDo,</firstDo>
    <lastDo>lastDo: #lastDo,</lastDo>
    <usable>usable: #usable,</usable>
    <round>round: #round,</round>
    <groupSkill>groupSkill: #groupSkill,</groupSkill>
    <animationColor>animationColor: #animationColor,</animationColor>
    <init>
      init(player: Player, skill) {
        #init
      },
    </init>
  })
  </object>
}
