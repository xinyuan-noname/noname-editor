    <ai>ai: @__技能智能值(#ai),</ai>
  }
}

// ═════════════════════════════════ 使用类 ════════════════════════════════════
// 旧版编辑器 kind = 'enable:"chooseToUse"'；出牌阶段之外也能主动使用的技能。
macro @使用技(
  #技能: Ident?,
  #名称: Str?,
  #描述: Str?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #强制发动: Bool?,
  #自动发动: Bool?,
