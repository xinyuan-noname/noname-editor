  #觉醒技: Bool?,
  #使命技: Bool?,
  #技能动画: Bool?,
  #主公技: Bool?,
  #转换技: Bool?,
  #隐匿技: Bool?,
  #宗族技: Bool?,
  #昂扬技: Bool?,
  #蓄力技: Bool?,
  #阵法技: Bool?,
  #主将技: Bool?,
  #副将技: Bool?,
  #技能预亮: expr?,
  #死亡角色可选: Bool?,
  #离场角色可选: Bool?,
  #多名角色: Bool?,
  #复合选角色: Bool?,
  #不失去牌: Bool?,
  #不弃置牌: Bool?,
  #延时: Bool?,
  #复合选卡牌: Bool?,
  #标记持续显示: Bool?,
  #多指示线: Bool?,
  #最先触发: Bool?,
  #最后触发: Bool?,
  #次数: Num?,
  #轮次: Num?,
  #势力技: Str?,
  #动画颜色: Str?,
  #初始化: stmt
) {
  <对象>
  #技能 = #对象
  // @自由技能 的对象来自 #对象 槽，标签并不进字面量，只能挂上去（省略时 Object.assign(x, {}) 是无害空操作）
  Object assign(#技能, {
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
    <强制发动>forced: #强制发动,</强制发动>
    <自动发动>frequent: #自动发动,</自动发动>
    <直接发动>direct: #直接发动,</直接发动>
    <死亡可发动>forceDie: #死亡可发动,</死亡可发动>
    <锁定技>locked: #锁定技,</锁定技>
    <持恒技>persevereSkill: #持恒技,</持恒技>
    <Charlotte>charlotte: #Charlotte,</Charlotte>
    <superCharlotte>superCharlotte: #superCharlotte,</superCharlotte>
    <限定技>limited: #限定技,</限定技>
    <觉醒技>juexingji: #觉醒技,</觉醒技>
    <使命技>dutySkill: #使命技,</使命技>
    <技能动画>skillAnimation: #技能动画,</技能动画>
    <主公技>zhuSkill: #主公技,</主公技>
    <转换技>zhuanhuanji: #转换技,</转换技>
    <隐匿技>hiddenSkill: #隐匿技,</隐匿技>
    <宗族技>clanSkill: #宗族技,</宗族技>
    <昂扬技>sunbenSkill: #昂扬技,</昂扬技>
    <蓄力技>chargeSkill: #蓄力技,</蓄力技>
    <阵法技>zhenfa: #阵法技,</阵法技>
    <主将技>mainSkill: #主将技,</主将技>
    <副将技>viceSkill: #副将技,</副将技>
    <技能预亮>preHidden: #技能预亮,</技能预亮>
    <死亡角色可选>deadTarget: #死亡角色可选,</死亡角色可选>
    <离场角色可选>includeOut: #离场角色可选,</离场角色可选>
    <多名角色>multitarget: #多名角色,</多名角色>
    <复合选角色>complexTarget: #复合选角色,</复合选角色>
    <不失去牌>lose: #不失去牌,</不失去牌>
