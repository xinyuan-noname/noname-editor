// ═══════════════════════════════ 视为技 ═════════════════════════════════════
// 视为技不是旧版的独立类别（editor.mjs:475 的 isViewAs 判定），而是叠加在上面
// 任意一种 enable 上：把牌「当作」另一张牌使用/打出。省略 #enable 时默认
// ["chooseToUse","chooseToRespond"]（武圣、倾国这一类）。
//   #视为: { name: "shan" }          → 当作闪
//   #视为: { name: "sha", nature: "fire" } → 当作火杀
macro @视为技(
  #技能: Ident?,
  #名称: Str?,
  #描述: Str?,
  // ── 技能标签（旧版「技能标签」页 39 项；一律不过滤：任何标签都能写在任何宏上）──
  //    槽名就是产物字段名；数据与映射在 module/editor/shya/tags.mjs；
  //    编辑器的「标签」面板会把选中标签写进宏体里的 //#tags-begin … //#tags-end 托管区。
  #强制发动: Bool?,
  #自动发动: Bool?,
  #直接发动: Bool?,
  #死亡可发动: Bool?,
  #锁定技: Bool?,
  #持恒技: Bool?,
  #Charlotte: Bool?,
  #superCharlotte: Bool?,
  #限定技: Bool?,
  #觉醒技: Bool?,
  #使命技: Bool?,
  #技能动画: Bool?,
  #主公技: Bool?,
  #转换技: Bool?,
  #隐匿技: Bool?,
  #宗族技: Bool?,
  #昂扬技: Bool?,
  #蓄力技: Bool?,
  #阵法技: Bool?,
  #主将技: Bool?,
  #副将技: Bool?,
  #技能预亮: expr?,
  #死亡角色可选: Bool?,
  #离场角色可选: Bool?,
  #多名角色: Bool?,
  #复合选角色: Bool?,
  #不失去牌: Bool?,
  #不弃置牌: Bool?,
  #延时: Bool?,
  #复合选卡牌: Bool?,
  #标记持续显示: Bool?,
  #多指示线: Bool?,
  #最先触发: Bool?,
  #最后触发: Bool?,
  #次数: Num?,
  #轮次: Num?,
  #势力技: Str?,
  #动画颜色: Str?,
  #初始化: stmt,
  #enable: expr?,
  #视为: ObjectLit?,
  #牌条件: stmt,
  #牌值条件: expr?,
  #视为筛选: stmt,
  #选牌: expr?,
  #位置: Str?,
  #提示: Str?,
  #询问: stmt,
  #效果: stmt,
  #ai: ObjectLit?
) {
  #技能 = {
    enable: @__技能启用值(#enable),
    <名称>translation: #名称,</名称>
    <描述>description: #描述,</描述>
    // ── 技能标签（省略的标签整条消失，顺序与 TAG_SLOTS 一致）──
