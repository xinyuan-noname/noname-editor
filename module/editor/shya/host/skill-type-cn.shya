    <延时>delay: #延时,</延时>
    <复合选卡牌>complexCard: #复合选卡牌,</复合选卡牌>
    <标记持续显示>mark: #标记持续显示,</标记持续显示>
    <多指示线>multiline: #多指示线,</多指示线>
    <最先触发>firstDo: #最先触发,</最先触发>
    <最后触发>lastDo: #最后触发,</最后触发>
    <次数>usable: #次数,</次数>
    <轮次>round: #轮次,</轮次>
    <势力技>groupSkill: #势力技,</势力技>
